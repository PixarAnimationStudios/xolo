<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>KeepAlive</key>
  <true/>
  <key>Label</key>
  <string>com.pixar.xoloserver</string>
  <!-- You probably want to set these environment variables
  <key>EnvironmentVariables</key>
  <dict>
    <key>GEM_PATH</key>
    <string>/path/to/gems1:/path/to/gems2</string>
    <key>PATH</key>
    <string>/path/to/things1:/path/to/things2</string>
  </dict>
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/xoloserver</string>
    <!-- On production servers, uncomment this line:
    <string>-p</string>
    -->

    <!-- to start the server with debug-logging on, uncomment this line:
    <string>-d</string>
    -->
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Library/Application Support/xoloserver/logs/xoloserver.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Application Support/xoloserver/logs/xoloserver.log</string>
</dict>
</plist>